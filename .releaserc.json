{
	"branches": ["main"],
	"plugins": [
		"@semantic-release/commit-analyzer",
		"@semantic-release/release-notes-generator",
		"@semantic-release/npm",
		["@semantic-release/exec", { "prepareCmd": "npm run bundle" }],
		[
			"@semantic-release/github",
			{ "assets": [{ "path": "starshipit-mcp.mcpb", "label": "MCPB bundle" }] }
		]
	]
}

{
  "name": "@devkind/starshipit-mcp",
  "mcpName": "io.github.devkindhq/starshipit-mcp",
  "version": "1.0.0",
  "description": "MCP server for the StarShipIt shipping API: orders, shipments, labels, tracking, rates, manifests, address book and products",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "starshipit",
    "shipping",
    "logistics",
    "ecommerce",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devkindhq/starshipit-mcp.git"
  },
  "license": "ISC",
  "author": {
    "name": "Devkind",
    "url": "https://devkind.com.au"
  },
  "type": "module",
  "bin": {
    "starshipit-mcp": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "bundle": "node scripts/build-mcpb.js",
    "sync-tools": "node scripts/sync-manifest-tools.js"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "^1.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@eslint/js": "^10.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "fflate": "^0.8.3",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "resolutions": {
    "zod": "^4.6.7"
  }
}

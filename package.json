{
  "name": "starshipit-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for StarShipIt API integration — orders, shipments, tracking, rates, manifests, address book, and products",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "starshipit-mcp-server": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
